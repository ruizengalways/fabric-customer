{
  "properties": {
    "description": "Reusable Framework certification child Pipeline. Exact seven Framework parameters are forwarded to one worker Notebook.",
    "parameters": {
      "framework_pipeline_run_id": {"type": "String"},
      "framework_dataset_run_id": {"type": "String"},
      "dataset_id": {"type": "String"},
      "run_mode": {"type": "String"},
      "attempt": {"type": "Int"},
      "effective_config_hash": {"type": "String"},
      "execution_plan_hash": {"type": "String"}
    },
    "activities": [
      {
        "name": "ExecuteFrameworkDataset",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "typeProperties": {
          "notebookId": "__NOTEBOOK_ID__",
          "workspaceId": "__WORKSPACE_ID__",
          "parameters": {
            "framework_pipeline_run_id": {"value": {"value": "@pipeline().parameters.framework_pipeline_run_id", "type": "Expression"}, "type": "string"},
            "framework_dataset_run_id": {"value": {"value": "@pipeline().parameters.framework_dataset_run_id", "type": "Expression"}, "type": "string"},
            "dataset_id": {"value": {"value": "@pipeline().parameters.dataset_id", "type": "Expression"}, "type": "string"},
            "run_mode": {"value": {"value": "@pipeline().parameters.run_mode", "type": "Expression"}, "type": "string"},
            "attempt": {"value": {"value": "@pipeline().parameters.attempt", "type": "Expression"}, "type": "int"},
            "effective_config_hash": {"value": {"value": "@pipeline().parameters.effective_config_hash", "type": "Expression"}, "type": "string"},
            "execution_plan_hash": {"value": {"value": "@pipeline().parameters.execution_plan_hash", "type": "Expression"}, "type": "string"},
            "customer_inputs_root": {"value": "__CUSTOMER_INPUTS_ROOT__", "type": "string"},
            "runtime_auth_mode": {"value": "__RUNTIME_AUTH_MODE__", "type": "string"},
            "control_plane_server": {"value": "__CONTROL_PLANE_SERVER__", "type": "string"},
            "control_plane_database": {"value": "__CONTROL_PLANE_DATABASE__", "type": "string"},
            "warehouse_server": {"value": "__WAREHOUSE_SERVER__", "type": "string"},
            "warehouse_database": {"value": "__WAREHOUSE_DATABASE__", "type": "string"},
            "key_vault_url": {"value": "__KEY_VAULT_URL__", "type": "string"},
            "control_plane_secret_name": {"value": "__CONTROL_PLANE_SECRET_NAME__", "type": "string"},
            "warehouse_secret_name": {"value": "__WAREHOUSE_SECRET_NAME__", "type": "string"}
          },
          "sessionTag": "framework-certification"
        }
      }
    ]
  }
}
